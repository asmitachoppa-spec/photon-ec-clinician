# Photon sandbox -- same org as the patient app.
PHOTON_CLIENT_ID=your_photon_client_id
PHOTON_CLIENT_SECRET=your_photon_client_secret
PHOTON_ORG_ID=your_photon_org_id
PHOTON_AUDIENCE=https://api.neutron.health
PHOTON_TOKEN_URL=https://auth.neutron.health/oauth/token
PHOTON_API_URL=https://api.neutron.health/graphql
PHOTON_CLINICAL_API_URL=https://clinical-api.neutron.health/graphql

# Used by the embedded Elements <photon-client> AND the browser-side
# prescriptionScreen script for the real prescriber login -- this is a
# DIFFERENT client ID than PHOTON_CLIENT_ID above. Photon's sandbox
# dashboard provisions two separate Auth0 app registrations per org: a
# "Machine to Machine Application" (PHOTON_CLIENT_ID, confidential,
# backend-only) and a "Single Page Application" (this one, public, for
# browser logins, with its own whitelisted callback URLs). Find it under
# your org's sandbox dashboard settings, in the "Single Page Application"
# card -- using the M2M client ID here instead fails with an Auth0
# "Callback URL mismatch" page (its allowlist doesn't include this app's
# URL at all) and, even if that's worked around, doesn't produce a token
# Photon's clinical API treats as a real logged-in user.
PHOTON_ELEMENTS_CLIENT_ID=your_photon_element_client_id
# Point this at wherever this app is actually running -- must exactly
# match (including trailing slash) an entry in that SPA app's whitelisted
# callback URLs.
PHOTON_ELEMENTS_REDIRECT_URI=http://localhost:5100/
PHOTON_DEV_MODE=true

# Shared Postgres -- same value as the patient app's .env.
DATABASE_URL=postgresql://localhost:5432/photon_ec

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=5100
